      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed ekle"
          }
        }
      }
    },
    "Add a feed and its newest articles show up here.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir feed ekle, en yeni makaleleri burada görünsün."
          }
        }
      }
    },
    "Add your first feed: paste a site or feed address.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk feed'ini ekle: bir site ya da feed adresi yapıştır."
          }
        }
      }
    },
    "Added %lld feeds, %lld were already here. New feeds are fetched in the background.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Added %1$lld feeds, %2$lld were already here. New feeds are fetched in the background."
