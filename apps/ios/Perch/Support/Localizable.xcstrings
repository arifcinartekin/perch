    },
    "Glass effect": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cam efekti"
          }
        }
      }
    },
    "How see-through and blurred the panels are. Off gives solid panels and bars. iOS's own Reduce Transparency setting also makes them solid.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panellerin ne kadar şeffaf ve bulanık olacağı. Kapalıyken paneller ve çubuklar düz renk olur. iOS'un Saydamlığı Azalt ayarı da onları düz yapar."
          }
        }
      }
    },
    "I already have an account": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten hesabım var"
          }
        }
      }
    },
