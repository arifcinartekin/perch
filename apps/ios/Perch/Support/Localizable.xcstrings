      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm Feed'ler"
          }
        }
      }
    },
    "All articles": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm makaleler"
          }
        }
      }
    },
    "All caught up": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hepsi okundu"
          }
        }
      }
    },
    "Always": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman"
          }
        }
      }
    },
    "Anyone with the link can read this note. Edits show there too.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Linki olan herkes bu notu okuyabilir. Düzenlemelerin orada da görünür."
          }
        }
      }
    },
    "Anyone with this code can read and change what the chain syncs. Only show it to your own devices.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu koda sahip herkes zincirin senkronladıklarını okuyup değiştirebilir. Yalnızca kendi cihazlarınıza gösterin."
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünüm"
          }
        }
      }
    },
    "Articles": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makaleler"
          }
        }
      }
    },
    "Articles saved on this iPhone for offline reading are removed, and Perch goes back to the library on this iPhone.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı okumak için bu iPhone'a kaydedilen makaleler silinir ve Perch bu iPhone'daki kitaplığa döner."
          }
        }
      }
    },
    "At least 8 characters. Your other devices are signed out and need the new password.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az 8 karakter. Diğer cihazlarının oturumu kapanır ve yeni şifre gerekir."
          }
        }
      }
    },
