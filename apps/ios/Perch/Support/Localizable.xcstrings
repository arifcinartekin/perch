    },
    "This server uses end-to-end encryption, which the iPhone app doesn't support yet.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucu uçtan uca şifreleme kullanıyor; iPhone uygulaması bunu henüz desteklemiyor."
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad"
          }
        }
      }
    },
    "Titles and article text; secondary text is a softer shade.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlıklar ve makale metni; ikincil metin daha soluk bir tonda."
