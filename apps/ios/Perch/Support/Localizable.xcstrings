{
  "sourceLanguage": "en",
  "strings": {
    "%@ options": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seçenekleri"
          }
        }
      }
    },
    "%lld feeds on this iPhone": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld feed on this iPhone"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld feeds on this iPhone"
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone'da %lld feed"
          }
        }
      }
    },
    "%lld min read": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dk okuma"
          }
        }
      }
    },
    "%lld new articles": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld yeni makale"
          }
        }
      }
    },
    "%lld newest": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En yeni %lld"
          }
        }
      }
    },
    "%lld%@": {
      "shouldTranslate": false
    },
    "A calm place for your feeds": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed'lerin için sakin bir yer"
          }
        }
      }
    },
    "A link": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bağlantı"
          }
        }
      }
    },
    "A notification when background refresh finds new articles. iOS decides how often that runs, usually every hour or so.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka plan yenilemesi yeni makale bulduğunda bildirim gelir. Bunun ne sıklıkla çalışacağına iOS karar verir, genelde saatte bir kadar."
          }
        }
      }
    },
    "A sync chain keeps this iPhone, your browsers and your other devices in step: feeds, categories, read and starred articles, theme and colours. Everything is encrypted on your devices with the chain's code; the relay that passes it on can't read your feeds or what you read.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkron zinciri bu iPhone'u, tarayıcılarınızı ve diğer cihazlarınızı eşit tutar: feed'ler, kategoriler, okunan ve yıldızlı makaleler, tema ve renkler. Her şey cihazlarınızda zincirin koduyla şifrelenir; bunu ileten aktarıcı feed'lerinizi ya da ne okuduğunuzu göremez."
          }
        }
      }
    },
    "Accent": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vurgu"
          }
        }
      }
    },
    "Account": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekle"
          }
        }
      }
    },
    "Add a device": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz ekle"
          }
        }
      }
    },
    "Add a feed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed ekle"
          }
        }
      }
    },
    "Add a feed and its newest articles show up here.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir feed ekle, en yeni makaleleri burada görünsün."
          }
        }
      }
    },
    "Add a note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Not ekle"
          }
        }
      }
    },
    "Add email": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posta ekle"
          }
        }
      }
    },
    "Add your first feed: paste a site or feed address.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk feed'ini ekle: bir site ya da feed adresi yapıştır."
          }
        }
      }
    },
    "Added %lld feeds, %lld were already here. New feeds are fetched in the background.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Added %1$lld feeds, %2$lld were already here. New feeds are fetched in the background."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld feed eklendi, %2$lld tanesi zaten vardı. Yeni feed'ler arka planda getiriliyor."
          }
        }
      }
    },
    "Added %lld feeds. New feeds are fetched in the background.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld feed eklendi. Yeni feed'ler arka planda getiriliyor."
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres"
          }
        }
      }
    },
