      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenle…"
          }
        }
      }
    },
    "Every browser and phone signed in to your account. Swipe to sign one out.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabında oturum açık olan tüm tarayıcı ve telefonlar. Oturumu kapatmak için kaydır."
          }
        }
      }
    },
    "Everything syncs through your Perch Server: feeds, read and starred articles, theme and colours. Changes made offline are sent when you're back.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey Perch Server'ın üzerinden senkronlanır: feed'ler, okunan ve yıldızlı makaleler, tema ve renkler. Çevrimdışıyken yapılan değişiklikler bağlantı gelince gönderilir."
          }
        }
      }
    },
    "Export subscriptions": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikleri dışa aktar"
          }
        }
      }
    },
    "Feed text": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed metni"
          }
        }
      }
    },
    "Feeds": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed'ler"
          }
        }
      }
    },
    "Feeds and reading history live on your own server, not someone else's.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed'lerin ve okuma geçmişin başkasının değil, kendi sunucunda durur."
          }
        }
      }
    },
    "Filled buttons; their label colour is picked for contrast.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolgulu düğmeler; yazı rengi okunaklı olacak şekilde seçilir."
          }
        }
      }
    },
    "Font": {
      "localizations": {
