        }
      }
    },
    "Every device in it stops syncing. Feeds, articles and settings stay on each one.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zincirdeki her cihazın senkronu durur. Feed'ler, makaleler ve ayarlar her cihazda kalır."
          }
        }
      }
    },
    "Everything syncs through your Perch Server: feeds, read and starred articles, theme and colours. Changes made offline are sent when you're back.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
