    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perch uses the camera only to scan a sync chain's QR code."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perch kamerayı yalnızca senkron zincirinin QR kodunu okutmak için kullanır."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perch uses Face ID to unlock the app when you've turned on the app lock."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama kilidini açtıysan Perch, uygulamanın kilidini açmak için Face ID'yi kullanır."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perch connects to your Perch Server when it runs on your local network."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perch Server'ın yerel ağında çalışıyorsa Perch ona bağlanır."
          }
        }
