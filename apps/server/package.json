{
  "name": "@perch/server",
  "version": "0.1.0",
  "description": "Perch Server — self-hostable sync and feed-fetching server.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@perch/core": "*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
