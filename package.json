{
  "name": "perch",
  "version": "0.1.0",
  "description": "Perch — a privacy-first RSS reader: browser extension, self-hostable server and mobile app.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @perch/extension",
    "dev:firefox": "npm run dev:firefox -w @perch/extension",
    "build": "npm run build -w @perch/extension",
    "build:firefox": "npm run build:firefox -w @perch/extension",
    "zip": "npm run zip -w @perch/extension",
    "zip:firefox": "npm run zip:firefox -w @perch/extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.0"
  }
}
