{
	servers {
		# Requests through Cloudflare's proxy keep the visitor's address in
		# X-Forwarded-For; anyone else's header is replaced. Ranges from
		# https://www.cloudflare.com/ips/
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

# The relay for sync chains can have its own name (e.g. sync.perch.ws). It's the
# same server, but there it answers only the chain API: no web app, no sign-in,
# no sign-up, just a page saying what the address is.
{$PERCH_DOMAIN} {$PERCH_SYNC_DOMAIN} {
	@sync host {$PERCH_SYNC_DOMAIN:sync.invalid}
	handle @sync {
		# /server lets the apps check that this is a relay before joining.
		@relay path /api/v1/chain /api/v1/chain/* /api/v1/server
		handle @relay {
			reverse_proxy perch:8080
		}
		handle /api/* {
			header Content-Type application/json
			respond `{"error":"not-found","message":"This address only relays sync chains"}` 404
		}
		handle {
			header {
				Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
				Referrer-Policy no-referrer
				X-Content-Type-Options nosniff
			}
			root * /srv/sync
			try_files {path} /index.html
			file_server
		}
	}
	handle {
		reverse_proxy perch:8080
	}
}
